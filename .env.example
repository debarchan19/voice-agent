LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_secret_here
ANTHROPIC_API_KEY=sk-ant-...
# Which LLM the agents use: anthropic (default, Claude) or local (self-hosted, see docs/self_hosting.md).
# To switch back to Claude, set this to anthropic or remove it.
LLM_BACKEND=anthropic
# Only used when LLM_BACKEND=local (these are the defaults)
LOCAL_LLM_BASE_URL=http://127.0.0.1:8001/v1
LOCAL_LLM_MODEL=qwen3.6-35b-a3b
LOCAL_LLM_TEMPERATURE=0.2
DEEPGRAM_API_KEY=your_deepgram_key
CARTESIA_API_KEY=your_cartesia_key
# Optional: a Cartesia voice ID. Leave blank for the default voice.
CARTESIA_VOICE_ID=
TAVILY_API_KEY=tvly-...

# Gmail SMTP for confirmation emails. Use a Google app password (16 chars, no spaces),
# not your normal password: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# Optional: send every confirmation email to this address instead of the customer's
DEMO_RECIPIENT_EMAIL=

# Optional: also send every graph run to LangSmith (one thread per call)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=delivery-desk
